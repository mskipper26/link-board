# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Passkey required to unlock the app (choose a strong, random string).
LINK_BOARD_PASSKEY=change-me-to-a-strong-passkey

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Absolute path to this project's directory (where main.py lives).
LINK_BOARD_DIR=/path/to/link-board

# Directory containing the Python interpreter's bin (with `uvicorn`), prepended to PATH.
PYTHON_BIN_PATH=/path/to/python/bin

# Host and port uvicorn binds to.
HOST=0.0.0.0
PORT=8186

# Public URL the app is served at (e.g. via a reverse proxy or tunnel).
LINK_BOARD_URL=https://links.example.com
